{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "build": {
    "env": {
      "NODE_VERSION": "20.18.1"
    }
  },
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10,
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/unified",
      "destination": "/api/unified.js"
    },
    {
      "source": "/api/ical-export",
      "destination": "/api/unified.js?action=ical-export"
    },
    {
      "source": "/api/booking/confirm",
      "destination": "/api/booking-confirm.js"
    },
    {
      "source": "/api/send-final-email",
      "destination": "/api/send-final-email.js"
    },
    {
      "source": "/api/pricing",
      "destination": "/api/unified.js?action=pricing"
    },
    {
      "source": "/api/booking",
      "destination": "/api/unified.js?action=booking"
    },
    {
      "source": "/api/quote",
      "destination": "/api/unified.js?action=quote"
    },
    {
      "source": "/api/admin",
      "destination": "/api/unified.js?action=settings"
    },
    {
      "source": "/api/utilities",
      "destination": "/api/unified.js?action=sync-calendars"
    },
    {
      "source": "/api/create-payment-intent",
      "destination": "/api/create-payment-intent.js"
    },
    {
      "source": "/api/payments",
      "destination": "/api/payments.js"
    },
    {
      "source": "/api/emails",
      "destination": "/api/emails.js"
    },
    {
      "source": "/api/analytics",
      "destination": "/api/analytics.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/unified.js?action=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
