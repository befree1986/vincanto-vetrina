{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/unified",
      "destination": "/api/unified.js"
    },
    {
      "source": "/api/pricing",
      "destination": "/api/unified.js?action=pricing"
    },
    {
      "source": "/api/booking",
      "destination": "/api/unified.js?action=booking"
    },
    {
      "source": "/api/quote",
      "destination": "/api/unified.js?action=quote"
    },
    {
      "source": "/api/admin",
      "destination": "/api/unified.js?action=settings"
    },
    {
      "source": "/api/utilities",
      "destination": "/api/unified.js?action=sync-calendars"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/unified.js?action=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}